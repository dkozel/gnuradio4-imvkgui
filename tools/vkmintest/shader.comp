#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer Data
{
	float data[];
};

layout(push_constant) uniform PushConstants
{
	uint count;
} pc;

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if(i >= pc.count)
		return;
	data[i] = data[i] * 2.0;
}
